# PulseBridge AI — Supabase Environment Configuration
# Copy this file to .env or .env.local and add your real Supabase credentials.
#
# IMPORTANT:
# 1. Do NOT put your Supabase service_role key here (service_role bypasses RLS and must NEVER be in frontend code).
# 2. Do NOT put any AI provider API keys here.
# 3. Only publishable / anon keys are safe for frontend distribution.

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous / Publishable Key (publicly safe anon key)
VITE_SUPABASE_ANON_KEY=
